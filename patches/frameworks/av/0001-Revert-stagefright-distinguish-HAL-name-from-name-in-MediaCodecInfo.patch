 media/codec2/sfplugin/CCodec.cpp              |  9 ++--
 media/libmedia/MediaCodecInfo.cpp             | 29 -----------
 media/libmedia/include/media/MediaCodecInfo.h | 26 ++--------
 .../MediaPlayerService.cpp                    |  4 +-
 media/libstagefright/ACodec.cpp               | 11 ++---
 media/libstagefright/MediaCodecListWriter.cpp | 49 +------------------
 .../media/stagefright/foundation/AString.h    |  3 --
